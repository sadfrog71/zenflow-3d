<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.deepdimen</groupId>
        <artifactId>matrix-work</artifactId>
        <version>1.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>matrix-work-biz</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-skill-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-work-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-assistant-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-assistant-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-assistant-provider-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-capsule-biz</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-assistant-provider-testkit</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-common-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-upms-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.deepdimen</groupId>
            <artifactId>matrix-upms-biz</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>com.deepdimen</groupId>
                    <artifactId>matrix-common-gateway</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>cloud</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>repackage</goal>
                                </goals>
                                <configuration>
                                    <loaderImplementation>CLASSIC</loaderImplementation>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>boot</id>
        </profile>
    </profiles>
</project>
