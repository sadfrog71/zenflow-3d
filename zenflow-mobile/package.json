{
  "name": "zenflow-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.15",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.102.8",
    "@wuba/react-native-echarts": "^3.1.1",
    "echarts": "^6.1.0",
    "expo": "~57.0.19",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.16",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.20",
    "expo-web-browser": "~57.0.2",
    "mermaid": "^11.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "^1.0.2",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tslib": "2.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:pods": "cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 RUBYOPT=-r../scripts/cocoapods-utf8.rb pod install",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build:web": "node scripts/web/build.mjs",
    "preview:web": "node scripts/web/preview.mjs",
    "build:web:preview": "node scripts/web/build.mjs --preview",
    "build:rest": "node scripts/zenflow/build-home.cjs && node scripts/zenflow/build-garden.cjs && node scripts/zenflow/build-pond.cjs && node scripts/zenflow/build-reading-room-native.cjs"
  },
  "enriched-markdown": {
    "enableCodeHighlight": false,
    "enableMath": false,
    "codeHighlightLanguages": []
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/plugins/__tests__/native-config.test.js"
    ]
  },
  "overrides": {
    "echarts": {
      "tslib": "2.8.1"
    },
    "zrender": {
      "tslib": "2.8.1"
    }
  },
  "private": true
}
